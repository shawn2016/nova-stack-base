# Staging 示例：与 production 相同，禁用 TypeORM synchronize
NODE_ENV=production
PORT=3001
APP_ROLE=api
CORS_ORIGINS=https://admin.staging.example.com
SKIP_EXTERNAL_SERVICES=false
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=nova_app
DB_PASSWORD=replace-with-managed-database-secret
DB_DATABASE=nova_project_staging
DB_SYNCHRONIZE=false
# 每进程连接预算；实例数 × pool size 不应超过数据库连接上限
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10000
# 慢查询告警阈值（毫秒），并非 SQL 强制取消时间
DB_MAX_QUERY_EXECUTION_TIME=1000
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=nova:project:staging:
REDIS_USERNAME=
REDIS_PASSWORD=
# 托管 TLS Redis 使用 true（系统信任根证书校验，禁止跳过证书验证）
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000
JWT_SECRET=change-me-staging
JWT_EXPIRES_IN=7d
OSS_ENABLED=false
APP_PUBLIC_URL=https://api.staging.example.com
UPLOAD_MAX_SIZE=5242880

# 通用入口保护与监控：生产不可关闭限流；每实例指标需分别抓取
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
REQUEST_BODY_LIMIT_KB=256
READINESS_TIMEOUT_MS=2000
# 独立监控凭据，至少32字符；留空则 /api/health/metrics 返回404
METRICS_TOKEN=
# 生产必须使用对象存储；该变量优先于数据库存储设置
UPLOAD_STORAGE_PROVIDER=aliyun_oss
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_BASE_URL=
