NODE_ENV=development
PORT=3001
APP_ROLE=all
# 表结构通过 migration 管理；仅一次性本地实验可显式 DB_SYNCHRONIZE=true（生产拒绝）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SKIP_EXTERNAL_SERVICES=false
# MySQL（pnpm seed 需要）
# 脚手架本地 demo 用 nova_stack；从 Template 创建的业务项目请改用 server/.env.project.example
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=nova_stack
DB_SYNCHRONIZE=false
# 每进程连接预算；实例数 × pool size 不应超过数据库连接上限
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=10000
# 慢查询告警阈值（毫秒），并非 SQL 强制取消时间
DB_MAX_QUERY_EXECUTION_TIME=1000
# 跳过 seed：SKIP_SEED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=nova:dev:
REDIS_USERNAME=
REDIS_PASSWORD=
# 托管 TLS Redis 使用 true（系统信任根证书校验，禁止跳过证书验证）
REDIS_TLS=false
REDIS_CONNECT_TIMEOUT=5000
REDIS_COMMAND_TIMEOUT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# 文件上传（默认本地模式）
OSS_ENABLED=false
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
APP_PUBLIC_URL=http://localhost:3000
UPLOAD_MAX_SIZE=5242880

# 通用入口保护与监控：生产不可关闭限流；每实例指标需分别抓取
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
REQUEST_BODY_LIMIT_KB=256
READINESS_TIMEOUT_MS=2000
# 独立监控凭据，至少32字符；留空则 /api/health/metrics 返回404
METRICS_TOKEN=
# 生产必须使用对象存储；该变量优先于数据库存储设置
UPLOAD_STORAGE_PROVIDER=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_PUBLIC_BASE_URL=
