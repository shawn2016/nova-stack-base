# ============================================================
# 业务项目专用环境变量模板（从脚手架 Template 创建后使用）
# 用法：cp server/.env.project.example server/.env
# ============================================================

NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
SKIP_EXTERNAL_SERVICES=false

# --- MySQL：每个项目独立库名（勿用 nova_stack）---
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
# 改成项目短名，例如 nova_stack_my_crm
DB_DATABASE=nova_stack_my_project

# --- Redis：可共用实例，建议不同 logical db 避免 key 冲突 ---
REDIS_HOST=localhost
REDIS_PORT=6379
# ioredis 若支持可选 db index；或保持默认并确保不与其它项目同时跑同一套 seed 测试
# REDIS_DB=1

# --- 安全：业务项目必须更换 ---
JWT_SECRET=change-me-to-random-string-for-this-project
JWT_EXPIRES_IN=7d

# 文件上传（默认本地模式）
OSS_ENABLED=false
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PUBLIC_BASE_URL=
APP_PUBLIC_URL=http://localhost:3001
UPLOAD_MAX_SIZE=5242880
