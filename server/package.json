{
  "name": "@nova/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node src/database/seeds/run-seed.ts",
    "test": "pnpm exec jest --config ./test/jest-unit.json --runInBand",
    "test:e2e": "pnpm exec jest --config ./test/jest-e2e.json --runInBand",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit --incremental false",
    "migration:run": "ts-node src/database/tools/migrate.ts run",
    "migration:revert": "ts-node src/database/tools/migrate.ts revert",
    "migration:check": "ts-node src/database/tools/migrate.ts check",
    "migration:baseline": "ts-node src/database/tools/migrate.ts baseline",
    "worker": "node dist/worker",
    "dev:worker": "ts-node src/worker.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nova/shared-types": "workspace:*",
    "@prometheus-io/client": "^0.16.1",
    "ali-oss": "^6.23.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "cron": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "5.2.1",
    "helmet": "^8",
    "ioredis": "^5.6.0",
    "mysql2": "^3.14.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.22"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.12",
    "@types/ali-oss": "^6.23.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cron": "^2.4.3",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^11.9.1",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
